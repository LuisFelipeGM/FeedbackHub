                  ],
                  "path": [
                    "avaliacao"
                  ]
                },
                "description": "Nota entre 4 e 7 => Urgencia.MEDIA => só persiste, sem notificação. Esperado: 201."
              },
              "response": []
            },
            {
              "name": "Avaliar Aula - Urgência Baixa",
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
