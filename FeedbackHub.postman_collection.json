                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n    \"descricao\": \"Aula ruim, professor não apareceu\",\r\n    \"nota\": 2,\r\n    \"aulaId\": \"aula-01\"\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrlAvaliacao}}/avaliacao",
                  "host": [
                    "{{baseUrlAvaliacao}}"
                  ],
                  "path": [
                    "avaliacao"
                  ]
                },
                "description": "Nota <= 3 => Urgencia.ALTA => dispara notificação crítica por e-mail ao admin. Esperado: 201."
              },
              "response": []
            },
            {
              "name": "Avaliar Aula - Urgência Média",
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "{{token}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n    \"descricao\": \"Aula razoável, podia melhorar\",\r\n    \"nota\": 5,\r\n    \"aulaId\": \"aula-02\"\r\n}",
                  "options": {
                    "raw": {
