        {
          "name": "Sucesso",
          "item": [
            {
              "name": "Sign-Up Cognito (Aluno)",
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/x-amz-json-1.1"
                  },
                  {
                    "key": "X-Amz-Target",
                    "value": "AWSCognitoIdentityProviderService.SignUp"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"ClientId\": \"{{clientId}}\",\n  \"Username\": \"{{emailAluno}}\",\n  \"Password\": \"{{senhaAluno}}\",\n  \"UserAttributes\": [\n    { \"Name\": \"email\", \"Value\": \"{{emailAluno}}\" }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{cognitoEndpoint}}",
                  "host": [
                    "{{cognitoEndpoint}}"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Confirm Sign-Up Cognito (Aluno)",
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/x-amz-json-1.1"
                  },
                  {
                    "key": "X-Amz-Target",
                    "value": "AWSCognitoIdentityProviderService.ConfirmSignUp"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"ClientId\": \"{{clientId}}\",\n  \"Username\": \"{{emailAluno}}\",\n  \"ConfirmationCode\": \"COLE_O_CODIGO_RECEBIDO_POR_EMAIL\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{cognitoEndpoint}}",
                  "host": [
                    "{{cognitoEndpoint}}"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Login Cognito (Aluno)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.collectionVariables.set(\"token\", pm.response.json().AuthenticationResult.IdToken);"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/x-amz-json-1.1"
                  },
                  {
                    "key": "X-Amz-Target",
                    "value": "AWSCognitoIdentityProviderService.InitiateAuth"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"AuthFlow\": \"USER_PASSWORD_AUTH\",\n  \"ClientId\": \"{{clientId}}\",\n  \"AuthParameters\": {\n    \"USERNAME\": \"{{emailAluno}}\",\n    \"PASSWORD\": \"{{senhaAluno}}\"\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{cognitoEndpoint}}",
                  "host": [
                    "{{cognitoEndpoint}}"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Login Cognito (Admin)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.collectionVariables.set(\"tokenAdmin\", pm.response.json().AuthenticationResult.IdToken);"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/x-amz-json-1.1"
                  },
                  {
                    "key": "X-Amz-Target",
                    "value": "AWSCognitoIdentityProviderService.InitiateAuth"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"AuthFlow\": \"USER_PASSWORD_AUTH\",\n  \"ClientId\": \"{{clientId}}\",\n  \"AuthParameters\": {\n    \"USERNAME\": \"{{emailAdmin}}\",\n    \"PASSWORD\": \"{{senhaAdmin}}\"\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{cognitoEndpoint}}",
                  "host": [
                    "{{cognitoEndpoint}}"
                  ]
                },
                "description": "Pré-requisito: usuário ADMIN criado manualmente (ver README, seção \"Administradores\"), com senha já definida como permanente via admin-set-user-password --permanent."
              },
              "response": []
            }
          ]
        },
